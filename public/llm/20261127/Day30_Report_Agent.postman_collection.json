            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"RAG 근거 인용 정확도 향상\",\n  \"category_code\": \"RESEARCH_PLAN\",\n  \"top_k\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (![\"intermediate\",\"advanced\"].includes(pm.environment.get('project_level'))) { pm.execution.skipRequest(); }",
                  "if (pm.environment.get('allow_paid_llm') !== 'true') { console.log('유료 실행 비동의: skip'); pm.execution.skipRequest(); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200',()=>pm.response.to.have.status(200));const r=pm.response.json();pm.test('same candidates',()=>pm.expect(r.before.map(x=>x.report_id).sort()).to.eql(r.after.map(x=>x.report_id).sort()));pm.test('lineage',()=>pm.expect(r.query_search).to.include(r.query_original));"
                ]
              }
            }
          ]
        }
      ]
