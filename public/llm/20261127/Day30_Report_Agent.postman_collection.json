                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const r=pm.response.json();",
                  "pm.test('response state and contract',()=>{pm.expect(r.status).to.eql(\"completed\");pm.expect(r.request_id).to.be.a('string');pm.expect(r.answer).to.be.a('string');pm.expect(r.sources).to.be.an('array');pm.expect(r.tool_trace).to.be.an('array');pm.expect(r.validation.citations_match_context).to.eql(true);pm.expect(r.latency_ms).to.be.a('number');});",
                  "const expected=[\"rag_search\"];",
                  "pm.test('real server trace / required tools',()=>{const actual=r.tool_trace.filter(t=>t.status==='found'||t.status==='not_found').map(t=>t.tool);expected.forEach(t=>pm.expect(actual).to.include(t));pm.expect(new Set(r.tool_trace.map(t=>t.tool_call_id)).size).to.eql(r.tool_trace.length);});",
                  "if (r.status==='completed') {pm.test('required tools observed',()=>pm.expect(r.validation.required_tools_observed).to.eql(true));pm.environment.set('request_id',r.request_id);} else {pm.test('no false citation',()=>pm.expect(r.sources).to.have.lengthOf(0));}",
                  "// Faithfulness/정답성은 실제 보고서 원문과 사람이 별도로 대조합니다."
                ]
              }
            }
