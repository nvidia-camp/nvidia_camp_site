 "sql": {
  "select": "SELECT id, title\nFROM knowledge\nWHERE category_id = 1\nORDER BY id;",
  "join": "SELECT k.id, k.title, c.name AS category\nFROM knowledge AS k\nJOIN categories AS c\n  ON c.id = k.category_id\nORDER BY k.id;",
  "left_join": "SELECT c.name AS category, k.title\nFROM categories AS c\nLEFT JOIN knowledge AS k\n  ON k.category_id = c.id\nORDER BY c.id, k.id;",
  "group_by": "SELECT c.name AS category,\n       COUNT(k.id) AS knowledge_count\nFROM categories AS c\nLEFT JOIN knowledge AS k\n  ON k.category_id = c.id\nGROUP BY c.id, c.name\nORDER BY c.id;",
  "insert": "INSERT INTO knowledge (title, content, category_id)\nVALUES ('임시 안내', '한 번만 실행합니다.', 1)\nRETURNING id;",
  "update": "UPDATE knowledge\nSET content = '실행 전에 가상환경을 확인합니다.'\nWHERE id = 2;",
  "delete": "DELETE FROM knowledge\nWHERE id = 3;",
  "create_table": "CREATE TABLE knowledge (\n  id          BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,\n  title       VARCHAR(80) NOT NULL\n              CHECK (char_length(title) BETWEEN 1 AND 80),\n  content     TEXT NOT NULL\n              CHECK (char_length(content) BETWEEN 1 AND 2000),\n  category_id BIGINT NOT NULL\n              REFERENCES categories (id) ON DELETE RESTRICT\n);",
